# =============================================================================
# ZYNTEKSIS — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# For Vercel / production, set the same keys in the hosting provider dashboard.
# Never commit real secrets. This file contains placeholders only.
# Full reference: ENVIRONMENT_VARIABLES.md
# Maintainer docs index: docs/README.md
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public URL of this deployment (no trailing slash).
# Production: https://zynteksisv.vercel.app
NEXT_PUBLIC_APP_URL="https://zynteksisv.vercel.app"

# Display name shown in the UI and transactional emails.
NEXT_PUBLIC_APP_NAME="ZYNTEKSIS"

# -----------------------------------------------------------------------------
# Supabase — Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
# Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# anon / public key (safe for the browser; RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# service_role key (server only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -----------------------------------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys
# Required in production for the AI assistant. Optional in local development.
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-your-openai-api-key"

# Model id used by the chat assistant (override if your account uses another)
OPENAI_MODEL="gpt-4o-mini"

# -----------------------------------------------------------------------------
# Resend — https://resend.com/api-keys
# Required in production for invite / auth-related emails. Optional locally.
# Verify a sending domain in Resend, then set EMAIL_FROM accordingly.
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="ZYNTEKSIS <noreply@your-domain.com>"

# -----------------------------------------------------------------------------
# Cron authentication
# Used by Vercel Cron → /api/cron/* (Authorization: Bearer <CRON_SECRET>).
# Generate a long random string, e.g.: openssl rand -hex 32
# Also set the same value as CRON_SECRET in the Vercel project env.
# -----------------------------------------------------------------------------
CRON_SECRET="generate-a-long-random-secret"

# -----------------------------------------------------------------------------
# Logging
# One of: debug | info | warn | error
# -----------------------------------------------------------------------------
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# OAuth providers (Authentication v2) — Google & GitHub only
# Enable providers and paste Client ID/Secret in Supabase Dashboard →
# Authentication → Providers. App env vars are optional references and do NOT
# gate login buttons (enabled state is read from Supabase Auth settings).
# Full setup: docs/authentication.md
# Redirect URL: {NEXT_PUBLIC_APP_URL}/auth/callback
# Also add in Supabase Auth → URL Configuration → Redirect URLs.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Optional — local migration helper scripts only (scripts/*.mjs)
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Not read by the Next.js app at runtime.
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# -----------------------------------------------------------------------------
# Optional — development only
# Skips Zod env validation so tooling can boot without full secrets.
# FORBIDDEN when NODE_ENV=production (the app will throw).
# -----------------------------------------------------------------------------
# SKIP_ENV_VALIDATION="true"
